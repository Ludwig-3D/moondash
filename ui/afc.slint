import { I18n } from "i18n.slint";
import { ScrollView } from "std-widgets.slint";
import { Icons } from "icons.slint";
import { Palette, Row, Label, Tile } from "widgets.slint";

export struct Lane {
    name: string,
    material: string,
    weight: string,
    color: color,
    ink: color,
    loaded: bool,
    has-filament: bool,
    has-runout: bool,
}

export component AfcPanel inherits HorizontalLayout {

    in property <bool> enabled;
    in property <[Lane]> lanes;
    in property <[Row]> units;
    callback action(string, string);

    spacing: 12px;

    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 12px;

        if root.lanes.length == 0: Label {
            text: I18n.text("no_units_present");
            horizontal-alignment: center;
            color: Palette.muted;
        }

        for lane in root.lanes: lane-card := Rectangle {
            horizontal-stretch: 1;
            max-width: 112px;
            border-radius: 11px;
            border-width: lane.loaded ? 2px : 0px;
            border-color: Palette.accent;
            background: lane.color;
            clip: true;
            private property <color> action-tonal: lane.ink.transparentize(88%);

            VerticalLayout {
                if lane.has-filament: HorizontalLayout {
                    height: 44px;
                    Tile {
                        icon: Icons.pencil; fill: lane-card.action-tonal; ink: lane.ink; border-radius: 0px; min-width: 0px;
                        enabled: root.enabled && !lane.loaded;
                        clicked => { root.action("afc-edit", lane.name); }
                    }
                    Tile {
                        icon: Icons.infinity; fill: lane-card.action-tonal; ink: lane.has-runout ? Palette.success : lane.ink; border-radius: 0px; min-width: 0px;
                        enabled: root.enabled;
                        clicked => { root.action("afc-runout", lane.name); }
                    }
                }

                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Label { text: lane.material; color: lane.ink; font-size: 19px; font-weight: 600; horizontal-alignment: center; }
                    if lane.weight != "": Label { text: lane.weight; color: lane.ink; font-size: 12px; horizontal-alignment: center; }
                }

                if lane.has-filament: HorizontalLayout {
                    height: 44px;
                    Tile {
                        icon: Icons.eject; fill: lane-card.action-tonal; ink: lane.ink; border-radius: 0px; min-width: 0px;
                        enabled: root.enabled && !lane.loaded;
                        clicked => { root.action("afc-unload", lane.name); }
                    }
                    Tile {
                        icon: Icons.tray-arrow-down; fill: lane-card.action-tonal; ink: lane.ink; border-radius: 0px; min-width: 0px;
                        enabled: root.enabled && !lane.loaded;
                        clicked => { root.action("afc-load", lane.name); }
                    }
                }
            }
        }
    }

    Rectangle {
        width: 110px;
        border-radius: 6px;
        background: Palette.raised;
        ScrollView {
            VerticalLayout {
                padding: 5px;
                spacing: 4px;

                for unit in root.units: Tile {
                    label: unit.title;
                    active: unit.active;
                    fill: unit.active ? Palette.accent : transparent;
                    clicked => { root.action("afc-unit", unit.title); }
                }
            }
        }
    }
}
