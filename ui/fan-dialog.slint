import { I18n } from "i18n.slint";
import { Spinner } from "std-widgets.slint";
import { Label, Palette, Tile } from "widgets.slint";

component FanStep inherits Rectangle {
    in property <string> caption;
    in property <bool> enabled;
    callback clicked;

    background: hit.pressed ? #ffffff12 : hit.has-hover ? #ffffff0c : #ffffff05;
    accessible-role: button;
    accessible-label: root.caption;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Label {
        text: root.caption;
        color: root.enabled ? Palette.ink : Palette.muted;
        font-size: 14px;
        horizontal-alignment: center;
    }

    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component FanDialog inherits Rectangle {

    in property <bool> ready;
    in property <bool> busy;
    in property <string> title;
    in property <string> error;
    in property <int> initial;
    callback save(int);
    callback close;

    private property <int> target: root.initial;
    private property <bool> compact: root.width < 742px;
    private property <length> inset: root.compact ? 16px : 24px;

    background: #00000052;
    TouchArea {}

    card := Rectangle {
        width: min(root.width - 48px, 760px);
        height: (root.compact ? 208px : 192px) + (root.error == "" ? 0px : 24px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Palette.surface;
        border-radius: 8px;
        clip: true;

        Label {
            x: root.inset; y: 24px;
            width: card.width - 2 * root.inset; height: 32px;
            text: root.title;
            font-size: 24px;
        }

        Label {
            x: root.inset; y: root.compact ? 65px : 80px;
            width: 120px; height: root.compact ? 25px : 52px;
            text: I18n.text("target");
            font-size: 20px;
        }

        controls := Rectangle {
            x: root.inset + (root.compact ? 0px : 144px);
            y: root.compact ? 96px : 80px;
            width: card.width - self.x - root.inset;
            height: 52px;
            border-radius: 12px;
            border-width: 1px;
            border-color: #ffffff24;
            clip: true;
            private property <length> step-width: min(60px, (self.width - 82px) / 6);

            Rectangle {
                x: 3 * controls.step-width; y: 1px;
                width: controls.width - 6 * controls.step-width;
                height: controls.height - 2px;
                background: Palette.ink.transparentize(94%);

                Label {
                    text: root.target;
                    color: Palette.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                Label {
                    x: parent.width - 28px;
                    width: 20px;
                    text: "%";
                    color: Palette.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
            }

            for step[index] in [-100, -10, -1, 1, 10, 100]: FanStep {
                x: index < 3 ? index * controls.step-width : controls.width - (6 - index) * controls.step-width;
                y: 1px; width: controls.step-width; height: controls.height - 2px;
                enabled: !root.busy;
                caption: step == -100 ? I18n.text("min") : step == 100 ? I18n.text("max") : step > 0 ? "+" + step : "" + step;
                clicked => { root.target = clamp(root.target + step, 0, 100); }
            }

            for index in 6: Rectangle {
                x: index < 3 ? (index + 1) * controls.step-width : controls.width - (6 - index) * controls.step-width;
                y: 1px; width: 1px; height: controls.height - 2px;
                background: #ffffff24;
            }
        }

        if root.error != "": Label {
            x: root.inset; y: controls.y + controls.height + 3px;
            width: card.width - 2 * root.inset; height: 21px;
            text: root.error; color: Palette.error; font-size: 13px;
        }

        HorizontalLayout {
            x: 8px; y: card.height - 52px;
            width: card.width - 16px; height: 52px;
            spacing: 8px;
            alignment: end;

            Tile {
                width: I18n.german ? 112px : 88px; height: 36px;
                fill: transparent;
                enabled: !root.busy;
                label: I18n.text("cancel_uppercase");
                clicked => { root.close(); }
            }

            Rectangle {
                width: I18n.german ? 110px : 68px; height: 36px;
                Tile {
                    fill: Palette.accent.transparentize(88%);
                    ink: Palette.accent;
                    enabled: root.ready && !root.busy;
                    label: root.busy ? "" : I18n.text("save_uppercase");
                    clicked => { root.save(root.target); }
                }
                if root.busy: Spinner { width: 20px; height: 20px; }
            }
        }
    }
}
