import { I18n } from "i18n.slint";
import { Spinner } from "std-widgets.slint";
import { GaugeSteps, PercentGauge } from "percent-gauge.slint";
import { Label, Palette, Tile } from "widgets.slint";

export component FanDialog inherits Rectangle {
    in property <bool> ready;
    in property <bool> busy;
    in property <string> title;
    in property <string> error;
    in property <int> initial;
    callback save(int);
    callback close;

    private property <int> target: root.initial;
    private property <bool> compact: root.height < 410px;
    private property <length> inset: root.width < 620px ? 16px : 24px;

    background: #00000052;
    TouchArea {}

    card := Rectangle {
        width: min(root.width - 48px, 760px);
        height: (root.compact ? 288px : 381px) + (root.error == "" ? 0px : 21px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Palette.surface;
        border-radius: 8px;
        clip: true;

        Label {
            x: root.inset; y: root.compact ? 12px : 24px;
            width: card.width - 2 * root.inset; height: 32px;
            text: root.title;
            font-size: 24px;
        }

        body := Rectangle {
            x: root.inset;
            y: root.compact ? 55px : 65px;
            width: card.width - 2 * root.inset;
            height: root.compact ? 190px : 252px;
            private property <length> step-width: min(104px, (self.width - dial.width) / 2 - 12px);

            GaugeSteps {
                x: (dial.x - body.step-width) / 2;
                y: 0px;
                width: body.step-width;
                height: body.height;
                steps: [-10, -1];
                shortcut-label: "0%";
                shortcut-enabled: root.target != 0;
                select-shortcut => { root.target = 0; }
                enabled: !root.busy;
                adjust(step) => { root.target = clamp(root.target + step, 0, 100); }
            }

            dial := PercentGauge {
                width: min(320px, body.height * 320 / 246, body.width - 124px);
                height: self.width * 246 / 320;
                x: (body.width - self.width) / 2;
                y: (body.height - self.height) / 2;
                target: root.target;
                readout: root.target + "%";
            }

            GaugeSteps {
                x: body.width - (dial.x + body.step-width) / 2;
                y: 0px;
                width: body.step-width;
                height: body.height;
                steps: [10, 1];
                shortcut-label: "100%";
                shortcut-enabled: root.target != 100;
                select-shortcut => { root.target = 100; }
                enabled: !root.busy;
                adjust(step) => { root.target = clamp(root.target + step, 0, 100); }
            }
        }

        if root.error != "": Label {
            x: root.inset; y: footer.y - self.height;
            width: card.width - 2 * root.inset; height: 20px;
            text: root.error; color: Palette.error; font-size: 13px;
        }

        footer := HorizontalLayout {
            x: 8px; y: card.height - self.height - 8px;
            width: card.width - 16px; height: 36px;
            spacing: 8px;
            alignment: end;

            Tile {
                width: I18n.german ? 99px : 78px; height: 36px;
                fill: transparent;
                enabled: !root.busy;
                label: I18n.text("cancel");
                clicked => { root.close(); }
            }

            Rectangle {
                width: I18n.german ? 100px : 68px; height: 36px;
                Tile {
                    fill: Palette.accent.transparentize(86%);
                    ink: Palette.accent;
                    enabled: root.ready && !root.busy;
                    label: root.busy ? "" : I18n.text("save");
                    clicked => { root.save(root.target); }
                }
                if root.busy: Spinner { width: 20px; height: 20px; }
            }
        }
    }
}
