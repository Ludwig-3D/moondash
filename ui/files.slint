import { I18n } from "i18n.slint";
import { Spinner, ScrollView } from "std-widgets.slint";
import { Icons } from "icons.slint";
import { Palette, Row, Label, Mdi, Tile } from "widgets.slint";

component FileCard inherits Rectangle {
    in property <Row> item;
    callback selected;
    callback context;
    border-radius: 8px;
    background: Palette.ink.transparentize(94%);
    clip: true;
    private property <bool> held;
    private property <bool> tracking;

    Timer {
        interval: 550ms;
        running: root.tracking;
        triggered => {
            root.tracking = false;
            root.held = true;
            root.context();
        }
    }

    if root.item.preview.width > 0: Image {
        source: root.item.preview;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    if root.item.action == "folder": VerticalLayout {
        alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        Mdi { text: Icons.folder; height: 48px; font-size: 48px; }
        Label { text: root.item.title; horizontal-alignment: center; font-weight: 600; wrap: word-wrap; }
    }

    if root.item.action == "file": Rectangle {
        if root.item.preview.width == 0 && !root.item.active: Mdi { text: Icons.printer-3d; font-size: 48px; }
        if root.item.preview.width == 0 && root.item.active: Spinner { width: 32px; height: 32px; }

        Rectangle {
            y: 0px;
            height: title.preferred-height + 16px;
            background: Palette.header;
            title := Label {
                x: 10px; y: 8px; width: parent.width - 20px;
                text: root.item.title; font-size: 13px; font-weight: 600; wrap: word-wrap;
            }
        }

        Rectangle {
            height: 33px;
            y: parent.height - self.height;
            background: Palette.header;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 4px;
                if root.item.detail != "": Mdi { text: Icons.clock-outline; font-size: 14px; width: 14px; color: Palette.muted; }
                Label { text: root.item.detail; font-size: 14px; color: Palette.muted; horizontal-stretch: 1; }
                if root.item.icon != "": Mdi { text: root.item.icon; font-size: 16px; width: 16px; color: root.item.tone; }
                if root.item.icon != "": Label { text: root.item.button; font-size: 14px; color: root.item.tone; }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if !root.held { root.selected(); } }
        moved => {
            if abs(self.mouse-x - self.pressed-x) > 12px || abs(self.mouse-y - self.pressed-y) > 12px {
                if root.tracking { root.held = true; }
                root.tracking = false;
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.held = false;
                if event.button == PointerEventButton.right && root.item.alternate != "" {
                    root.context();
                } else if event.button == PointerEventButton.left && root.item.alternate != "" {
                    root.tracking = true;
                }
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.tracking = false;
            }
        }
    }
}

export component FileBrowser inherits Rectangle {

    in property <bool> loading;
    in property <[Row]> entries;
    in property <[Row]> crumbs;
    in property <string> filter;
    in property <int> columns: 4;
    in property <int> rows: 3;
    in property <int> sort;
    in-out property <int> page;
    out property <int> capacity: columns * rows;
    callback action(string, string);

    VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        spacing: 12px;

        Rectangle {
            height: root.crumbs.length > 0 ? 100px : 48px;
            background: Palette.surface; border-radius: 8px;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        Rectangle {
                            width: 200px; height: 40px;
                            cross-axis-self-alignment: center;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Palette.ink.transparentize(88%);
                            clip: true;

                            HorizontalLayout {
                                for button[index] in [Icons.sort-clock-descending-outline, Icons.sort-clock-ascending-outline, Icons.sort-alphabetical-ascending, Icons.sort-alphabetical-descending]: HorizontalLayout {
                                    Tile {
                                        icon: button; active: root.sort == index;
                                        ink: self.active ? Palette.accent : Palette.ink;
                                        fill: self.active ? Palette.accent.transparentize(88%) : transparent;
                                        border-radius: 0px; width: 49px; height: 40px; icon-size: 24px;
                                        clicked => { root.action("file-sort", "\{index}"); }
                                    }
                                    if index < 3: Rectangle { width: 1px; height: 40px; background: Palette.ink.transparentize(88%); }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 40px;
                            cross-axis-self-alignment: center;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: filter-touch.has-hover ? Palette.muted : Palette.divider;
                            background: Palette.background;

                            HorizontalLayout {
                                height: 40px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Mdi {
                                    text: Icons.filter-outline;
                                    width: 24px;
                                    height: 24px;
                                    cross-axis-self-alignment: center;
                                    color: Palette.muted;
                                }
                                Label {
                                    horizontal-stretch: 1;
                                    height: 40px;
                                    text: root.filter == "" ? I18n.text("filter") : root.filter;
                                    color: root.filter == "" ? Palette.muted : Palette.ink;
                                }
                            }
                            filter-touch := TouchArea { mouse-cursor: pointer; clicked => { root.action("file-filter", ""); } }
                        }
                    }
                }

                if root.crumbs.length > 0: Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        Rectangle {
                            width: 38px;
                            height: 38px;
                            cross-axis-self-alignment: center;
                            border-radius: 6px;
                            background: back-touch.pressed ? Palette.divider
                                : back-touch.has-hover ? Palette.raised.brighter(10%) : Palette.raised;
                            Mdi { text: Icons.arrow-left; font-size: 21px; }
                            back-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.action("up", ""); }
                            }
                        }

                        ScrollView {
                            horizontal-stretch: 1;
                            height: 52px;
                            horizontal-scrollbar-policy: always-off;

                            HorizontalLayout {
                                alignment: start;
                                spacing: 4px;
                                Tile {
                                    icon: Icons.home-outline;
                                    icon-size: 21px;
                                    width: 38px;
                                    height: 38px;
                                    cross-axis-self-alignment: center;
                                    border-radius: 6px;
                                    clicked => { root.action("folder", ""); }
                                }
                                for crumb[index] in root.crumbs: HorizontalLayout {
                                    height: 52px;
                                    spacing: 4px;
                                    Mdi {
                                        text: Icons.chevron-right;
                                        font-size: 16px;
                                        width: 16px;
                                        height: 38px;
                                        cross-axis-self-alignment: center;
                                    }
                                    Rectangle {
                                        private property <bool> is-current: index + 1 == root.crumbs.length;
                                        width: crumb-label.preferred-width + 16px;
                                        height: 38px;
                                        cross-axis-self-alignment: center;
                                        border-radius: 5px;
                                        background: crumb-touch.has-hover && !self.is-current ? Palette.ink.transparentize(88%) : transparent;
                                        crumb-label := Label {
                                            x: 8px;
                                            y: 0px;
                                            width: parent.width - 16px;
                                            height: parent.height;
                                            text: crumb.title;
                                            font-size: 14px;
                                            font-weight: parent.is-current ? 600 : 400;
                                        }
                                        crumb-touch := TouchArea {
                                            enabled: !parent.is-current;
                                            mouse-cursor: pointer;
                                            clicked => { root.action("folder", crumb.argument); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        grid := Rectangle {
            vertical-stretch: 1;
            private property <length> gap: 16px;
            private property <length> card-width: (self.width - (root.columns - 1) * gap) / root.columns;
            private property <length> card-height: (self.height - (root.rows - 1) * gap) / root.rows;
            private property <int> offset: root.page * root.capacity;

            if root.loading: Spinner { width: 40px; height: 40px; }
            if !root.loading && root.entries.length == 0: Rectangle {
                width: I18n.german ? 250px : 215px;
                height: 50px;
                border-radius: 5px;
                background: Palette.info.transparentize(86%);
                Label {
                    text: I18n.text("no_print_files_found");
                    horizontal-alignment: center;
                }
            }

            for index in !root.loading ? clamp(root.entries.length - grid.offset, 0, root.capacity) : 0: FileCard {
                item: root.entries[grid.offset + index];
                width: grid.card-width;
                height: grid.card-height;
                x: mod(index, root.columns) * (grid.card-width + grid.gap);
                y: floor(index / root.columns) * (grid.card-height + grid.gap);
                selected => { root.action(self.item.action, self.item.argument); }
                context => { root.action("file-context", self.item.argument); }
            }
        }
    }

    if !root.loading && (root.page > 0 || (root.page + 1) * root.capacity < root.entries.length): VerticalLayout {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 48px;
        height: self.preferred-height;
        spacing: 8px;
        if root.page > 0: Tile { icon: Icons.chevron-up; height: 48px; border-radius: 24px; clicked => { root.page -= 1; root.action("file-page-previous", ""); } }
        if (root.page + 1) * root.capacity < root.entries.length: Tile { icon: Icons.chevron-down; height: 48px; border-radius: 24px; clicked => { root.page += 1; root.action("file-page-next", ""); } }
    }
}
