import { I18n } from "i18n.slint";
import { ScrollView } from "std-widgets.slint";
import { DashboardStats, DashboardStatsCard } from "dashboard-stats.slint";
import { Icons } from "icons.slint";
import { Palette, Row, Label, Mdi, Tile } from "widgets.slint";

export struct Notification {
    id: string,
    entry: Row,
    action-ink: color,
}

component PrintStat inherits VerticalLayout {
    in property <string> caption;
    in property <string> value;
    in property <TextHorizontalAlignment> align: left;
    spacing: 2px;

    Label { text: root.caption; font-size: 13px; height: 19px; color: Palette.muted; horizontal-alignment: root.align; }
    Label { text: root.value; font-size: 16px; height: 22px; font-weight: 700; horizontal-alignment: root.align; }
}

component PrintCardAction inherits Tile {
    in property <string> caption;
    in property <string> glyph;
    out property <length> natural-width: caption-label.preferred-width + 43px;
    border-radius: 0px;
    accessible-role: button;
    accessible-label: root.caption;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        alignment: center;

        Mdi { text: root.glyph; width: 20px; font-size: 20px; color: root.ink; }
        caption-label := Label {
            text: root.caption;
            color: root.ink;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}

component PrintCardActions inherits Rectangle {
    in property <bool> paused;
    in property <bool> finished;
    in property <bool> can-skip;
    in property <bool> can-reprint;
    callback action(string);

    private property <bool> show-primary: !root.finished || root.can-reprint;
    private property <length> skip-width: !root.finished && root.can-skip ? 40px : 0px;
    private property <length> primary-width: root.show-primary ? primary.natural-width : 0px;
    private property <length> natural-width: root.skip-width + root.primary-width + secondary.natural-width;
    private property <bool> split: root.show-primary && root.natural-width > root.width;
    height: root.split ? 72px : 36px;

    group := Rectangle {
        x: 0px;
        width: min(root.width, root.natural-width);
        height: root.height;
        border-radius: 14px;
        clip: true;

        if root.skip-width > 0px: Tile {
            x: 0px; y: 0px;
            width: root.skip-width; height: 36px;
            icon: Icons.debug-step-over;
            border-radius: 0px;
            clicked => { root.action("show-objects"); }
        }

        primary := PrintCardAction {
            visible: root.show-primary;
            x: root.skip-width; y: 0px;
            width: root.split ? group.width - self.x : root.primary-width;
            height: 36px;
            glyph: root.finished ? Icons.printer : root.paused ? Icons.play : Icons.pause;
            caption: root.finished ? I18n.text("reprint") : root.paused ? I18n.text("resume") : I18n.text("pause");
            fill: root.finished ? Palette.raised : root.paused ? Palette.success : Palette.warning;
            ink: root.finished ? Palette.ink : #ffffff;
            clicked => { root.action(root.finished ? "reprint" : root.paused ? "resume" : "pause"); }
        }

        secondary := PrintCardAction {
            x: root.split ? 0px : root.skip-width + root.primary-width;
            y: root.split ? 36px : 0px;
            width: group.width - self.x;
            height: 36px;
            glyph: root.finished ? Icons.broom : Icons.stop;
            caption: root.finished ? I18n.text("clear_file") : I18n.text("stop");
            fill: root.finished ? Palette.accent : Palette.error;
            ink: #ffffff;
            clicked => { root.action(root.finished ? "clear-file" : "cancel"); }
        }
    }
}

component Notice inherits Rectangle {
    in property <string> message;
    callback dismissed;
    min-height: 38px;
    background: Palette.info.transparentize(82%);
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 10px;
        spacing: 6px;
        Mdi { width: 20px; font-size: 20px; text: Icons.information-outline; color: Palette.info; }
        Label { text: root.message; horizontal-stretch: 1; font-weight: 600; }
        Tile { icon: Icons.close; fill: transparent; clicked => { root.dismissed(); } }
    }
}

component NotificationAction inherits Tile {
    in property <string> caption;
    in property <string> leading-icon;
    private property <length> inset: 12px;
    private property <length> icon-space: root.leading-icon == "" ? 0px : 28px;
    out property <length> natural-width: max(64px, caption-label.preferred-width + 2 * root.inset + root.icon-space);
    border-radius: 4px;
    accessible-role: button;
    accessible-label: root.caption;
    accessible-action-default => { root.clicked(); }

    if root.leading-icon != "": Mdi {
        x: root.inset;
        width: 18px;
        text: root.leading-icon;
        color: root.ink;
        font-size: 18px;
    }

    caption-label := Label {
        x: root.inset + root.icon-space;
        width: parent.width - self.x - root.inset;
        text: root.caption;
        color: root.ink;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
    }
}

component NotificationCard inherits Rectangle {
    in property <Notification> notification;
    in property <bool> compact;
    callback action(string, string);
    callback dismiss;
    private property <Row> entry: root.notification.entry;
    private property <length> icon-width: 24px;
    private property <length> column-gap: root.compact ? 8px : 10px;
    border-radius: 4px;
    clip: true;

    Rectangle {
        x: 8px;
        width: parent.width - self.x;
        height: parent.height;
        background: root.entry.tone.transparentize(88%);
    }

    Rectangle {
        x: 0px;
        width: 8px;
        height: parent.height;
        background: root.entry.tone.transparentize(62%);
    }

    VerticalLayout {
        padding-left: root.compact ? 12px : 16px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;
        alignment: start;

        HorizontalLayout {
            spacing: root.column-gap;

            VerticalLayout {
                width: root.icon-width;
                alignment: start;
                Mdi {
                    text: root.entry.icon;
                    color: root.entry.tone;
                    height: root.icon-width;
                    font-size: root.icon-width;
                }
            }

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                alignment: start;

                Label {
                    text: root.entry.title;
                    color: root.entry.tone;
                    font-size: 14px;
                    font-weight: 700;
                    wrap: word-wrap;
                    overflow: clip;
                }

                Label {
                    text: root.entry.detail;
                    color: root.entry.tone;
                    font-size: 14px;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }

            VerticalLayout {
                width: 32px;
                alignment: start;

                close := Tile {
                    min-width: 32px;
                    icon: Icons.close;
                    icon-size: 18px;
                    fill: transparent;
                    ink: root.entry.tone;
                    accessible-role: button;
                    accessible-label: I18n.text("dismiss_notification");
                    accessible-action-default => { close.clicked(); }
                    clicked => { root.dismiss(); }
                }
            }
        }

        if root.entry.action != "": VerticalLayout {
            padding-left: root.compact ? 0px : root.icon-width + root.column-gap;

            buttons := Rectangle {
                private property <bool> alternate: root.entry.alternate != "";
                private property <length> gap: 6px;
                private property <bool> wrap: alternate && first.natural-width + gap + second.natural-width > self.width;
                height: self.wrap ? 2 * 36px + gap : 36px;

                first := NotificationAction {
                    x: 0px; y: 0px;
                    width: min(self.natural-width, buttons.width);
                    height: 36px;
                    caption: root.entry.button;
                    leading-icon: root.entry.action == "show-updates" ? Icons.cog-outline : "";
                    fill: buttons.alternate ? transparent : root.entry.tone;
                    ink: buttons.alternate ? root.entry.tone : root.notification.action-ink;
                    clicked => { root.action(root.entry.action, root.entry.argument); }
                }

                second := NotificationAction {
                    visible: buttons.alternate;
                    x: buttons.wrap ? 0px : first.width + buttons.gap;
                    y: buttons.wrap ? 36px + buttons.gap : 0px;
                    width: min(self.natural-width, buttons.width);
                    height: 36px;
                    caption: root.entry.alternate-button;
                    fill: root.entry.tone;
                    ink: root.notification.action-ink;
                    clicked => { root.action(root.entry.alternate, root.entry.argument); }
                }
            }
        }
    }
}

export component Dashboard inherits HorizontalLayout {

    in property <bool> ready;
    in property <bool> online;
    in property <bool> printing;
    in property <bool> paused;
    in property <bool> finished;
    in property <bool> can-skip;
    in property <string> error;
    in property <string> message;
    in property <string> filename;
    in property <float> progress;
    in property <string> layers;
    in property <string> remaining;
    in property <image> logo;
    in property <image> preview;
    in property <[Row]> macros;
    in property <[Row]> controls;
    in property <[Row]> jobs;
    in property <bool> stats-enabled;
    in property <DashboardStats> stats;
    in property <length> stats-width: 260px;
    in property <[Notification]> notifications;
    in property <length> notification-width: 260px;
    private property <bool> loaded: filename != "" && (printing || paused || finished);
    callback action(string, string);

    spacing: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-right: 6px;

    Rectangle {
        horizontal-stretch: 1;
        background: Palette.surface;
        border-radius: 8px;
        clip: true;

        if root.loaded: Rectangle {
            if root.preview.width > 0: Image {
                source: root.preview;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }

            if root.preview.width == 0: Mdi {
                text: Icons.printer-3d;
                font-size: 96px;
                color: Palette.muted.transparentize(40%);
            }

            VerticalLayout {
                Rectangle {
                    height: root.message == "" ? 48px : 94px;
                    background: Palette.header;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-bottom: root.message != "" ? 8px : 0px;

                        Label { text: root.filename; font-size: 16px; font-weight: 700; height: 48px; }
                        if root.message != "": Notice {
                            message: root.message;
                            dismissed => { root.action("clear-message", ""); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    height: 106px + actions.height;
                    background: Palette.header;
                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 13px;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 12px;
                            PrintStat { caption: I18n.text("progress"); value: round(root.progress * 100) + "%"; horizontal-stretch: 1; }
                            PrintStat { caption: I18n.text("layer"); value: root.layers; align: center; horizontal-stretch: 1; }
                            PrintStat { caption: I18n.text("remaining"); value: root.remaining; align: right; horizontal-stretch: 1; }
                        }

                        track := Rectangle {
                            height: 10px;
                            border-radius: 5px;
                            clip: true;
                            background: Palette.secondary.transparentize(82%);
                            Rectangle { x: 0px; y: 0px; width: track.width * clamp(root.progress, 0, 1); height: track.height; background: Palette.accent; }
                        }

                        actions := PrintCardActions {
                            paused: root.paused;
                            finished: root.finished;
                            can-skip: root.can-skip;
                            can-reprint: root.jobs.length == 0;
                            action(name) => { root.action(name, ""); }
                        }
                    }
                }
            }
        }

        if !root.loaded: Rectangle {
            if root.online: Image {
                source: root.logo;
                width: 128px;
                height: 128px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                opacity: 0.6;
                image-fit: contain;
            }

            if root.message != "": Notice {
                x: 12px; y: 12px; width: parent.width - 24px; height: 38px;
                message: root.message;
                dismissed => { root.action("clear-message", ""); }
            }
        }
    }

    VerticalLayout {
        width: 64px;
        spacing: 8px;
        for shortcut in root.macros: Tile {
            icon: shortcut.icon;
            icon-size: 24px;
            height: 48px;
            active: shortcut.active;
            enabled: root.ready;
            clicked => { root.action(shortcut.action, shortcut.argument); }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 5px;
            background: Palette.raised;
            clip: true;

            VerticalLayout {
                for control in root.controls: VerticalLayout {
                    Tile {
                        height: 66px;
                        label: control.title;
                        icon: control.icon;
                        icon-size: 30px;
                        stacked: true;
                        border-radius: 0px;
                        enabled: root.ready;
                        ink: control.tone;
                        clicked => { root.action(control.action, control.argument); }
                    }
                    Rectangle { height: 1px; background: Palette.divider; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    if root.error != "" || root.notifications.length > 0 || (!root.printing && !root.paused && root.jobs.length > 0): Rectangle {
        width: root.notifications.length > 0 ? root.notification-width : 174px;
        background: Palette.surface;
        border-radius: 8px;
        clip: true;

        ScrollView {
            VerticalLayout {
                padding: root.notifications.length > 0 ? 0px : 8px;
                spacing: root.notifications.length > 0 ? 8px : 6px;
                alignment: root.notifications.length > 0 ? start : stretch;

                if root.error != "": VerticalLayout {
                    Label { text: root.error; wrap: word-wrap; overflow: clip; }
                    Tile { icon: Icons.close; fill: transparent; clicked => { root.action("dismiss", ""); } }
                }

                for notification in root.notifications: NotificationCard {
                    notification: notification;
                    compact: root.notification-width < 250px;
                    dismiss => { root.action("dismiss-notification", notification.id); }
                    action(name, argument) => { root.action(name, argument); }
                }

                if root.ready && root.error == "" && root.notifications.length == 0 && !root.printing && !root.paused && root.jobs.length > 0: VerticalLayout {
                    spacing: 5px;
                    Label { text: I18n.text("job_queue"); font-weight: 700; }
                    for job in root.jobs: Tile {
                        label: job.title;
                        icon: Icons.printer;
                        clicked => { root.action(job.action, job.argument); }
                    }
                }

            }
        }
    }

    if root.stats-enabled && root.notifications.length == 0 && root.error == "": DashboardStatsCard {
        width: root.stats-width;
        stats: root.stats;
    }
}
