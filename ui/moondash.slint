import { I18n } from "i18n.slint";
import { LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { Icons } from "icons.slint";
import { Palette, Row, Label, Mdi, Tile, Tab, RailButton } from "widgets.slint";
import { Dashboard, Notification } from "home.slint";
import { FilamentSensor, MotionPanel, PrintOptions } from "tune.slint";
import { FileBrowser } from "files.slint";
import { AfcPanel, Lane } from "afc.slint";
import { SpeedDialog } from "speed-dialog.slint";
import { TemperatureDialog } from "temperature-dialog.slint";
import { FanDialog } from "fan-dialog.slint";
import { StartupScreen } from "startup-screen.slint";
import { Keyboard } from "keyboard.slint";
import { PrintDialog, FolderPicker, PrintTool } from "print-dialogs.slint";
import { ConfigForm } from "settings.slint";
import { NetworkPanel, WifiDialogs, WifiEntry } from "network-settings.slint";
import { ColorPicker, ColorSwatch } from "color-picker.slint";
import { ToolsPanel } from "tools.slint";
import { MeshMarker, MeshViewDialog } from "mesh-view.slint";
import { ResourceMetric, McuResource, HistoryStatus, ResourcesPanel } from "resources.slint";
export { I18n, Palette, Row, Lane, PrintTool, ColorSwatch, Notification, FilamentSensor, WifiEntry, MeshMarker, ResourceMetric, McuResource, HistoryStatus }

component RowList inherits ScrollView {
    in property <[Row]> rows;
    callback action(string, string);

    VerticalLayout {
        spacing: 4px;

        for row in root.rows: Rectangle {
            min-height: 48px;
            border-radius: 5px;
            background: Palette.surface;

            HorizontalLayout {
                padding: 5px;
                padding-left: 10px;
                spacing: 8px;

                if row.icon != "": Mdi { text: row.icon; width: 27px; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Label { text: row.title; font-weight: 500; }
                    if row.detail != "": Label { text: row.detail; color: Palette.muted; font-size: 12px; }
                }
                if row.alternate != "": Tile {
                    label: row.alternate-button;
                    clicked => { root.action(row.alternate, row.argument); }
                }
                if row.action != "" && row.button != "": Tile {
                    label: row.button;
                    fill: row.active ? Palette.accent : Palette.raised;
                    clicked => { root.action(row.action, row.argument); }
                }
            }
            if row.action != "" && row.button == "": TouchArea {
                mouse-cursor: pointer;
                clicked => { root.action(row.action, row.argument); }
            }
        }
    }
}

export component Moondash inherits Window {
    title: "Moondash";
    preferred-width: 800px;
    preferred-height: 480px;
    min-width: 460px;
    min-height: 300px;
    background: Palette.background;
    default-font-size: 15px;

    in property <bool> dark: true;

    in property <bool> online;
    in property <bool> connected-once;
    in property <bool> ready;
    in property <string> klipper-state: "connecting";
    in property <bool> printing;
    in property <bool> paused;
    in property <bool> sleeping;
    in property <bool> debug;
    in property <string> connection;
    in property <string> message;
    in property <string> print-name;
    in property <bool> finished;
    in property <bool> can-skip;
    in property <string> display-message;
    in property <bool> has-afc;
    in property <bool> x-homed;
    in property <bool> y-homed;
    in property <bool> z-homed;
    in property <bool> has-tilt;
    in property <bool> has-qgl;
    in property <bool> motion-busy;
    in property <float> jog-step: 10;
    in property <string> flow: "100";
    in property <string> advance: "0";
    in property <string> smooth: "0";
    in property <[Row]> motion-controls;
    in property <[FilamentSensor]> sensors;
    in property <[Lane]> afc-lanes;
    in property <[Row]> afc-units;
    in property <[Row]> macros;
    in property <[Row]> jobs;
    in property <[Row]> details;
    in property <[Row]> trailing-rows;
    in property <[ResourceMetric]> resource-metrics;
    in property <image> resource-host-chart;
    in property <image> resource-history-chart;
    in property <[McuResource]> resource-mcus;
    in property <[HistoryStatus]> resource-history-statuses;
    in property <string> resource-system-description;
    in property <string> resource-print-count;
    in property <string> resource-total-time;
    in property <string> resource-longest-time;
    in property <string> resource-average-time;
    in property <string> resource-filament;
    in property <bool> resource-history-unavailable;
    in property <bool> resource-history-loading;
    in property <bool> resource-history-has-data;
    in property <bool> resource-history-empty;
    in property <bool> resource-history-stale;
    in property <string> resource-history-coverage;
    in-out property <bool> resource-history-details: false;
    in property <bool> resource-has-mcus;
    in property <image> web-qr;
    in property <string> web-url;
    in property <bool> network-wifi-available;
    in property <bool> network-wifi-enabled;
    in property <string> network-connected-ssid;
    in property <string> network-wifi-ip;
    in property <string> network-wifi-error;
    in property <[Row]> network-wired;
    in property <[Row]> network-can;
    in property <[WifiEntry]> network-scanned;
    in property <bool> network-scan-cached;
    in property <[WifiEntry]> network-saved;
    in property <string> network-job;
    in property <string> network-job-target;
    in property <string> network-error;
    in property <string> network-dialog;
    in property <string> network-password-title;
    in-out property <string> network-ssid;
    in-out property <string> network-password;
    in property <int> file-sort;
    in property <int> file-columns-config;
    in property <int> file-rows-config;
    out property <int> file-columns: root.file-columns-config > 0 ? root.file-columns-config : root.width < 800px || root.height < 480px ? 3 : root.width >= 1920px && root.height >= 1080px ? 6 : 4;
    out property <int> file-rows: root.file-rows-config > 0 ? root.file-rows-config : root.width < 800px || root.height < 480px ? 2 : root.width >= 1920px && root.height >= 1080px ? 4 : 3;
    in-out property <int> file-page;
    in property <float> progress;
    in property <string> layers: "—";
    in property <string> remaining: "—";
    in property <image> logo: @image-url("../images/logo.png");
    in property <image> preview;
    in property <image> tool-image;
    in property <string> tool-title;
    in property <[Row]> shortcuts;
    in property <[Row]> rows;
    in-out property <string> page: "home";
    in-out property <string> tab: "motion";
    in property <string> tool-view;
    in property <image> tool-mesh;
    in property <bool> tool-mesh-3d-open;
    in property <image> tool-mesh-3d;
    in property <bool> tool-mesh-3d-available;
    in property <[MeshMarker]> tool-mesh-markers;
    in property <string> tool-mesh-low;
    in property <string> tool-mesh-high;
    in property <string> tool-pid-target;
    in property <string> tool-pid-current;
    in property <[string]> tool-heater-options;
    in property <int> tool-heater-index;
    in property <bool> tool-pid-ready;
    in property <bool> tool-pid-running;
    in property <bool> tool-pid-complete;
    in property <bool> tool-webcam-loading;
    in property <string> tool-webcam-status;
    in property <int> tool-webcam-fps: -1;
    in property <[string]> tool-webcam-options;
    in property <int> tool-webcam-index;
    in property <[Row]> breadcrumbs;
    in property <bool> file-loading;
    in-out property <string> file-feedback;
    in-out property <string> filter;
    in property <string> config-text;
    in property <string> diagnostics;
    in property <color> picker-selected;
    in property <string> picker-extras-title;
    in property <[ColorSwatch]> picker-swatches;
    in property <[ColorSwatch]> picker-extras;
    in property <bool> picker-enabled: true;
    in property <string> dialog-title;
    in property <string> dialog-detail;
    in property <string> dialog-mode;
    in property <bool> dialog-secret;
    in-out property <string> dialog-value;
    in property <image> dialog-image;
    in property <string> dialog-time;
    in property <string> dialog-weight;
    in property <bool> file-busy;
    in property <bool> file-dialog-loading;
    in property <bool> move-valid;
    in property <string> move-destination;
    in-out property <string> move-name;
    in property <bool> folder-picker;
    in property <bool> folder-picker-loading;
    in property <bool> folder-picker-at-root;
    in property <string> folder-picker-path;
    in property <string> folder-picker-error;
    in property <[Row]> folder-picker-rows;
    in property <bool> folder-create;
    in property <bool> folder-create-valid;
    in-out property <string> folder-name;
    in property <[PrintTool]> print-tools;
    in property <bool> timelapse-available;
    in property <bool> timelapse-enabled;
    in property <bool> print-lane-picker;
    in property <bool> dialog-folder;
    in property <string> dialog-icon;
    in property <[Row]> dialog-options;
    in property <[Notification]> notifications;
    in property <string> dialog-unit;
    in property <string> dialog-current;
    in property <string> dialog-limit;
    in property <bool> printer-setting-busy;
    in property <int> speed-target: 100;
    in-out property <string> speed-acceleration;
    in property <int> temperature-target;
    in property <int> temperature-max;
    in property <int> fan-target;
    private property <bool> first-number-key;
    changed dialog-mode => { root.first-number-key = root.dialog-mode == "number"; }

    callback webcam-frame-tick(float, float);
    callback rotate-mesh(float, float, float, float, float);
    callback navigate(string, string);

    callback action(string, string);
    callback dialog-submit(string, bool);
    callback adjust-speed(int);
    pure callback format-speed-percent(int) -> string;
    callback dialog-close;
    callback erase-key;
    callback filter-edited(string);
    callback keyboard-erase(string);
    callback remove-acceleration-digit(string) -> string;
    callback picker-edited;
    in-out property <string> keyboard-target;

    function close-keyboard() {
        root.keyboard-target = "";
    }

    private property <bool> file-dialog: root.dialog-mode == "print" || root.dialog-mode.starts-with("file-");
    private property <bool> initial-connection-timed-out;
    private property <bool> klipper-starting: root.online && root.klipper-state == "startup";
    private property <bool> starting: root.klipper-starting
        || (!root.connected-once && !root.initial-connection-timed-out);

    Timer {
        interval: 8s;
        running: !root.connected-once && !root.initial-connection-timed-out && root.connection != "";
        triggered => { root.initial-connection-timed-out = true; }
    }


    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: !root.starting;
        Rectangle {
            width: 58px;
            background: Palette.background;

            VerticalLayout {
                padding-top: 17px;
                padding-bottom: 17px;
                spacing: 5px;
                RailButton { icon: Icons.home-variant; active: root.page == "home"; accessible-label: I18n.text("home"); clicked => { root.navigate("home", ""); } }
                RailButton { icon: Icons.tune-vertical-variant; active: root.page == "tune"; accessible-label: I18n.text("controls"); clicked => { root.navigate("tune", "motion"); } }
                RailButton { icon: Icons.printer-3d; active: root.page == "files"; accessible-label: I18n.text("files"); clicked => { root.navigate("files", ""); } }
                RailButton { icon: Icons.cog; active: root.page == "settings"; accessible-label: I18n.text("settings"); clicked => { root.navigate("settings", "network"); } }
                if root.debug: RailButton { icon: Icons.code-json; active: root.page == "debug"; accessible-label: I18n.text("debug"); clicked => { root.navigate("debug", ""); } }
                RailButton {
                    icon: root.printing || root.paused ? Icons.alert-octagon : Icons.power;
                    ink: root.printing || root.paused ? Palette.error : Palette.muted;
                    accessible-label: root.printing || root.paused ? I18n.text("emergency_stop") : I18n.text("power");
                    clicked => { root.action(root.printing || root.paused ? "emergency" : "power", ""); }
                }
            }
        }

        if root.page == "home": Dashboard {
            horizontal-stretch: 1;

            online: root.online;
            ready: root.ready;
            printing: root.printing;
            paused: root.paused;
            finished: root.finished;
            can-skip: root.can-skip;
            error: root.message;
            message: root.display-message;
            filename: root.print-name;
            progress: root.progress;
            layers: root.layers;
            remaining: root.remaining;
            logo: root.logo;
            preview: root.preview;
            macros: root.macros;
            controls: root.shortcuts;
            jobs: root.jobs;
            details: root.details;
            notifications: root.notifications;
            notification-width: root.width * 0.4;
            action(name, argument) => { root.action(name, argument); }
        }

        if root.page != "home": VerticalLayout {
            horizontal-stretch: 1;

            if root.page == "tune": Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-right: 8px;
                    spacing: 2px;
                    alignment: start;
                    Tab { width: 105px; label: I18n.text("controls"); active: root.tab == "motion"; clicked => { root.navigate("tune", "motion"); } }
                    if root.has-afc: Tab { width: 100px; label: I18n.text("filament"); active: root.tab == "afc"; clicked => { root.navigate("tune", "afc"); } }
                    Tab { width: 135px; label: I18n.text("print_options"); active: root.tab == "print"; clicked => { root.navigate("tune", "print"); } }
                    if root.tab == "objects": Tab { width: 105px; label: I18n.text("objects"); active: true; }
                    if root.tab == "queue": Tab { width: 115px; label: I18n.text("job_queue"); active: true; }
                }
            }

            if root.page == "settings": Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-right: 8px;
                    Tab { label: I18n.text("network"); active: root.tab == "network"; clicked => { root.navigate("settings", "network"); } }
                    Tab { label: I18n.text("settings"); active: root.tab == "config"; clicked => { root.navigate("settings", "config"); } }
                    Tab { label: I18n.text("tools"); active: root.tab == "tools"; clicked => { root.navigate("settings", "tools"); } }
                    Tab { label: I18n.text("resources"); active: root.tab == "host"; clicked => { root.navigate("settings", "host"); } }
                    Tab { label: I18n.text("shortcuts"); active: root.tab == "shortcuts"; clicked => { root.navigate("settings", "shortcuts"); } }
                    Tab { label: I18n.text("updates"); active: root.tab == "updates"; clicked => { root.navigate("settings", "updates"); } }
                }
            }

            if root.message != "": Rectangle {
                min-height: 34px;
                background: Palette.error.transparentize(81%);
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 6px;
                    Label { text: root.message; horizontal-stretch: 1; }
                    Tile { icon: Icons.close; fill: transparent; min-height: 34px; width: 38px; clicked => { root.action("dismiss", ""); } }
                }
            }

            if root.page == "tune" && root.tab == "motion": MotionPanel {
                vertical-stretch: 1;

                enabled: root.ready && !root.printing && !root.paused && !root.motion-busy;
                sensors-enabled: root.ready && !root.motion-busy;
                x-homed: root.x-homed;
                y-homed: root.y-homed;
                z-homed: root.z-homed;
                has-tilt: root.has-tilt;
                has-qgl: root.has-qgl;
                step: root.jog-step;
                controls: root.motion-controls;
                sensors: root.sensors;
                action(name, argument) => { root.action(name, argument); }
            }

            if root.page == "tune" && root.tab == "print": PrintOptions {
                vertical-stretch: 1;

                enabled: root.ready;
                flow: root.flow;
                advance: root.advance;
                smooth: root.smooth;
                action(name, argument) => { root.action(name, argument); }
            }

            if root.page == "tune" && root.tab == "afc": AfcPanel {
                vertical-stretch: 1;

                enabled: root.ready && !root.printing && !root.paused;
                lanes: root.afc-lanes;
                units: root.afc-units;
                action(name, argument) => { root.action(name, argument); }
            }

            if root.page == "files": FileBrowser {
                vertical-stretch: 1;

                entries: root.rows;
                crumbs: root.breadcrumbs;
                loading: root.file-loading;
                filter: root.filter;
                columns: root.file-columns;
                rows: root.file-rows;
                page <=> root.file-page;
                sort: root.file-sort;
                action(name, argument) => { root.action(name, argument); }
            }

            if root.page == "settings" && root.tab == "config": VerticalLayout {
                vertical-stretch: 1;
                padding: 8px;
                ConfigForm {
                    entries: root.rows;
                    action(name, argument) => { root.action(name, argument); }
                }
            }

            if root.page == "settings" && root.tab == "network": NetworkPanel {
                vertical-stretch: 1;
                wifi-available: root.network-wifi-available;
                wifi-enabled: root.network-wifi-enabled;
                ssid: root.network-connected-ssid;
                wifi-ip: root.network-wifi-ip;
                wifi-error: root.network-wifi-error;
                operation-error: root.network-dialog == "" ? root.network-error : "";
                job: root.network-job;
                wired: root.network-wired;
                can: root.network-can;
                web-qr: root.web-qr;
                web-url: root.web-url;
                action(name, argument) => { root.action(name, argument); }
            }

            if root.page == "debug": VerticalLayout {
                padding: 8px;
                spacing: 6px;
                TextEdit { text: root.diagnostics; read-only: true; vertical-stretch: 1; }
                Tile { icon: Icons.power; label: I18n.text("sleep_display"); clicked => { root.action("sleep", ""); } }
            }

            if root.page == "settings" && root.tab == "tools": ToolsPanel {
                vertical-stretch: 1;
                view: root.tool-view;
                title: root.tool-title;
                entries: root.rows;
                mesh: root.tool-mesh;
                mesh-low: root.tool-mesh-low;
                mesh-high: root.tool-mesh-high;
                mesh-3d-available: root.tool-mesh-3d-available;
                pid-target: root.tool-pid-target;
                pid-current: root.tool-pid-current;
                heater-options: root.tool-heater-options;
                heater-index: root.tool-heater-index;
                pid-ready: root.tool-pid-ready;
                pid-running: root.tool-pid-running;
                pid-complete: root.tool-pid-complete;
                awake: !root.sleeping;
                webcam-frame-tick(width, height) => { root.webcam-frame-tick(width, height); }
                webcam-loading: root.tool-webcam-loading;
                webcam-status: root.tool-webcam-status;
                webcam-fps: root.tool-webcam-fps;
                webcam-image: root.tool-image;
                webcam-options: root.tool-webcam-options;
                webcam-index: root.tool-webcam-index;
                action(name, argument) => { root.action(name, argument); }
            }

            if root.page == "settings" && root.tab == "host": ResourcesPanel {
                vertical-stretch: 1;
                metrics: root.resource-metrics;
                host-chart: root.resource-host-chart;
                history-chart: root.resource-history-chart;
                mcus: root.resource-mcus;
                history-statuses: root.resource-history-statuses;
                system-description: root.resource-system-description;
                print-count: root.resource-print-count;
                total-time: root.resource-total-time;
                longest-time: root.resource-longest-time;
                average-time: root.resource-average-time;
                filament: root.resource-filament;
                history-unavailable: root.resource-history-unavailable;
                history-loading: root.resource-history-loading;
                history-has-data: root.resource-history-has-data;
                history-empty: root.resource-history-empty;
                history-stale: root.resource-history-stale;
                history-coverage: root.resource-history-coverage;
                history-details: root.resource-history-details;
                history-view-changed(details) => { root.resource-history-details = details; }
                history-refresh-requested => { root.action("history-refresh", ""); }
                has-mcus: root.resource-has-mcus;
            }

            if (root.page == "tune" && root.tab != "motion" && root.tab != "print" && root.tab != "afc") ||
               (root.page == "settings" && root.tab != "network" && root.tab != "config" && root.tab != "host" && root.tab != "tools"): VerticalLayout {
                vertical-stretch: 1;
                padding: 8px;
                RowList { rows: root.rows; action(name, argument) => { root.action(name, argument); } }
            }
        }
    }

    if root.tool-mesh-3d-available && root.tool-mesh-3d-open && root.page == "settings" && root.tab == "tools" && root.tool-view == "mesh": MeshViewDialog {
        mesh: root.tool-mesh-3d;
        markers: root.tool-mesh-markers;
        rotate(yaw, pitch, zoom, viewport-width, viewport-height) => {
            root.rotate-mesh(yaw, pitch, zoom, viewport-width, viewport-height);
        }
        close => { root.action("mesh-close-3d", ""); }
    }

    if root.dialog-mode == "power": Rectangle {
        background: #00000099;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 24px, 730px);
            height: power-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface;
            border-radius: 8px;
            power-layout := VerticalLayout {
                padding: 14px;
                spacing: 12px;
                Label { text: I18n.text("power_options"); font-size: 20px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 12px;
                    Tile { stacked: true; icon: Icons.power; label: I18n.text("shut_down"); height: 124px; fill: Palette.error.transparentize(77%); clicked => { root.action("shutdown", ""); } }
                    Tile { stacked: true; icon: Icons.restart; label: I18n.text("reboot"); height: 124px; fill: Palette.warning.transparentize(77%); clicked => { root.action("reboot", ""); } }
                    Tile { stacked: true; icon: Icons.refresh; label: I18n.text("restart_klipper"); height: 124px; clicked => { root.action("restart-klipper", ""); } }
                    Tile { stacked: true; icon: Icons.chip; label: I18n.text("restart_firmware"); height: 124px; fill: Palette.info.transparentize(77%); clicked => { root.action("restart-firmware", ""); } }
                }
                HorizontalLayout {
                    alignment: end;
                    Tile { label: I18n.text("close"); fill: transparent; clicked => { root.dialog-close(); } }
                }
            }
        }
    }

    if root.file-dialog: PrintDialog {

        folder: root.dialog-folder;
        printing: root.printing || root.paused;
        ready: root.ready;
        busy: root.file-busy;
        loading: root.file-dialog-loading;
        can-move: root.move-valid;
        title: root.dialog-title;
        detail: root.dialog-detail;
        time: root.dialog-time;
        weight: root.dialog-weight;
        mode: root.dialog-mode;
        destination: root.move-destination;
        filename: root.move-name;
        preview: root.dialog-image;
        tools: root.print-tools;
        timelapse-available: root.timelapse-available;
        timelapse-enabled: root.timelapse-enabled;
        action(name, argument) => { root.action(name, argument); }
        close => { root.dialog-close(); }
    }

    if root.folder-picker: FolderPicker {

        loading: root.folder-picker-loading;
        busy: root.file-busy;
        creating: root.folder-create;
        create-valid: root.folder-create-valid;
        at-root: root.folder-picker-at-root;
        path: root.folder-picker-path;
        folder-name: root.folder-name;
        error: root.folder-picker-error;
        folders: root.folder-picker-rows;
        action(name, argument) => { root.action(name, argument); }
    }

    if root.print-lane-picker: Rectangle {
        background: #00000052;
        TouchArea { clicked => { root.action("close-print-lanes", ""); } }
        Rectangle {
            width: min(root.width - 48px, 470px);
            height: min(root.height - 48px, 340px);
            background: Palette.surface;
            border-radius: 8px;
            TouchArea {}
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Label { text: I18n.text("select_lane"); font-size: 19px; font-weight: 600; }
                RowList { rows: root.dialog-options; vertical-stretch: 1; action(name, argument) => { root.action(name, argument); } }
                HorizontalLayout {
                    alignment: end;
                    Tile { label: I18n.text("cancel"); min-width: 90px; fill: transparent; clicked => { root.action("close-print-lanes", ""); } }
                }
            }
        }
    }
    if root.dialog-mode == "color": ColorPicker {

        title: root.dialog-title;
        extras-title: root.picker-extras-title;
        error: root.dialog-detail;
        selected: root.picker-selected;
        swatches: root.picker-swatches;
        extras: root.picker-extras;
        enabled: root.picker-enabled || root.ready;
        busy: root.printer-setting-busy;
        choose(hex) => { root.dialog-submit(hex, false); }
        close => { root.dialog-close(); }
    }

    if root.dialog-mode == "speed": SpeedDialog {

        busy: root.printer-setting-busy;
        ready: root.ready;
        target: root.speed-target;
        readout: root.format-speed-percent(root.speed-target);
        adjust(step) => { root.adjust-speed(step); }
        acceleration <=> root.speed-acceleration;
        error: root.dialog-detail;
        remove-last(value) => { return root.remove-acceleration-digit(value); }
        save => { root.dialog-submit("", false); }
        close => { root.dialog-close(); }
    }

    if root.dialog-mode == "temperature": TemperatureDialog {

        busy: root.printer-setting-busy;
        ready: root.ready;
        title: root.dialog-title;
        icon: root.dialog-icon;
        current: root.dialog-current;
        target: root.temperature-target;
        maximum: root.temperature-max;
        error: root.dialog-detail;
        entry <=> root.dialog-value;
        erase => { root.erase-key(); }
        save(value) => { root.dialog-submit(value, false); }
        close => { root.dialog-close(); }
    }

    if root.dialog-mode == "fan": FanDialog {

        busy: root.printer-setting-busy;
        ready: root.ready;
        title: root.dialog-title;
        error: root.dialog-detail;
        initial: root.fan-target;
        save(value) => { root.dialog-submit("" + value, false); }
        close => { root.dialog-close(); }
    }

    if root.dialog-mode == "number": Rectangle {
        background: #00000099;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 20px, 760px);
            height: min(parent.height - 20px, 420px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Palette.surface;

            VerticalLayout {
                padding: 16px;
                spacing: 9px;
                HorizontalLayout {
                    spacing: 9px;
                    Mdi { text: root.dialog-icon; font-size: 26px; width: 28px; }
                    Label { text: root.dialog-title; font-size: 21px; font-weight: 600; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;

                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.raised;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 10px;
                                alignment: center;
                                Label { text: I18n.text("target"); color: Palette.muted; }
                                Label {
                                    text: (root.dialog-value == "" ? "0" : root.dialog-value) + root.dialog-unit;
                                    font-size: 29px; color: Palette.accent; font-weight: 700;
                                }
                            }
                        }

                        if root.dialog-current != "": Rectangle {
                            vertical-stretch: 1;
                            background: Palette.raised;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 10px;
                                alignment: center;
                                Label { text: I18n.text("current"); color: Palette.muted; }
                                Label { text: root.dialog-current; font-size: 21px; font-weight: 600; }
                            }
                        }

                        if root.dialog-limit != "": Rectangle {
                            vertical-stretch: 1;
                            background: Palette.raised;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 10px;
                                alignment: center;
                                Label { text: I18n.text("maximum"); color: Palette.muted; }
                                Label { text: root.dialog-limit; font-size: 21px; font-weight: 600; }
                            }
                        }
                    }

                    pad := Rectangle {
                        horizontal-stretch: 2;
                        private property <length> key-width: (self.width - 16px) / 3;
                        private property <length> key-height: (self.height - 24px) / 4;
                        for key[index] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "clear", "0", "erase"]: Tile {
                            x: mod(index, 3) * (pad.key-width + 8px);
                            y: floor(index / 3) * (pad.key-height + 8px);
                            width: pad.key-width;
                            height: pad.key-height;
                            min-height: 0px;
                            icon: key == "clear" ? Icons.trash-can-outline : key == "erase" ? Icons.backspace-outline : "";
                            label: key == "clear" || key == "erase" ? "" : key;
                            clicked => {
                                if key == "clear" {
                                    root.dialog-value = "";
                                } else if key == "erase" {
                                    root.erase-key();
                                } else {
                                    root.dialog-value = root.first-number-key ? key : root.dialog-value + key;
                                }
                                root.first-number-key = false;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 7px;
                    Label { text: root.dialog-detail; color: Palette.muted; font-size: 13px; horizontal-stretch: 1; }
                    if root.dialog-unit == " mm": Tile {
                        label: ".";
                        clicked => {
                            if root.first-number-key { root.dialog-value = "0."; root.first-number-key = false; }
                            else if root.dialog-value.is-float() { root.dialog-value += "."; }
                        }
                    }
                    Tile { label: I18n.text("cancel"); fill: transparent; clicked => { root.dialog-close(); } }
                    Tile { label: I18n.text("set"); active: true; clicked => { root.dialog-submit(root.dialog-value == "" ? "0" : root.dialog-value, false); } }
                }
            }
        }
    }

    if root.dialog-mode != "" && root.dialog-mode != "power" && root.dialog-mode != "number" && root.dialog-mode != "temperature" && root.dialog-mode != "fan" && root.dialog-mode != "speed" && root.dialog-mode != "color" && !root.file-dialog: Rectangle {
        background: #00000099;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 22px, 520px);
            height: min(parent.height - 18px, dialog-layout.preferred-height + 4px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Palette.surface;

            dialog-layout := VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Label { text: root.dialog-title; font-size: 19px; font-weight: 700; }
                if root.dialog-detail != "": Text { text: root.dialog-detail; color: Palette.muted; wrap: word-wrap; }
                if root.dialog-image.width > 0: Image { source: root.dialog-image; image-fit: contain; height: 100px; }
                if root.dialog-mode == "menu": VerticalLayout {
                    spacing: 6px;
                    for option in root.dialog-options: Tile {
                        label: option.title;
                        icon: option.icon;
                        clicked => { root.action(option.action, option.argument); }
                    }
                }
                if root.dialog-mode == "text": Rectangle {
                    height: 48px;
                    border-width: 1px;
                    border-color: Palette.divider;
                    border-radius: 5px;
                    clip: true;
                    if root.dialog-secret: TextInput {
                        x: 12px; width: parent.width - 24px;
                        text: root.dialog-value; input-type: password; read-only: true;
                        color: Palette.ink; vertical-alignment: center;
                    }
                    if !root.dialog-secret: Label {
                        x: 12px; width: parent.width - 24px;
                        text: root.dialog-value == "" ? "…" : root.dialog-value;
                    }
                    TouchArea { clicked => { root.keyboard-target = "dialog"; } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Tile { label: I18n.text("back"); clicked => { root.dialog-close(); } }
                    if root.dialog-mode != "info" && root.dialog-mode != "menu": Tile { label: I18n.text("ok_uppercase"); active: true; clicked => { root.dialog-submit(root.dialog-value, false); } }
                }
            }
        }
    }

    if root.page == "files" && root.file-feedback != "" && !root.folder-picker: Rectangle {
        width: min(root.width - 100px, 356px);
        height: 46px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 8px;
        border-radius: 5px;
        background: Palette.success;
        HorizontalLayout {
            padding-left: 12px;
            Label { text: root.file-feedback; color: #111111; horizontal-stretch: 1; }
            Tile {
                label: I18n.text("close"); ink: #111111; fill: transparent;
                clicked => { root.file-feedback = ""; }
            }
        }
    }

    if root.network-dialog != "": WifiDialogs {
        mode: root.network-dialog;
        job: root.network-job;
        job-target: root.network-job-target;
        error: root.network-error;
        ssid: root.network-ssid;
        password: root.network-password;
        password-title: root.network-password-title;
        scanned: root.network-scanned;
        scan-cached: root.network-scan-cached;
        saved: root.network-saved;
        action(name, argument) => { root.action(name, argument); }
        edit(field) => { root.keyboard-target = field; }
    }

    if root.keyboard-target == "wifi-ssid" && root.network-dialog == "hidden": Keyboard {
        title: I18n.text("ssid");
        value <=> root.network-ssid;
        erase => { root.keyboard-erase("wifi-ssid"); }
        accepted => { root.keyboard-target = "wifi-password"; }
        dismissed => { root.close-keyboard(); }
    }

    if root.keyboard-target == "wifi-password" && (root.network-dialog == "hidden" || root.network-dialog == "password"): Keyboard {
        secret: true;
        title: I18n.text("password");
        value <=> root.network-password;
        erase => { root.keyboard-erase("wifi-password"); }
        accepted => { root.close-keyboard(); }
        dismissed => { root.close-keyboard(); }
    }

    if root.keyboard-target == "filter": Keyboard {

        title: I18n.text("filter_print_files_by_name");
        value <=> root.filter;
        edited(value) => { root.filter-edited(value); }
        erase => { root.keyboard-erase("filter"); }
        accepted => { root.close-keyboard(); }
        dismissed => { root.close-keyboard(); }
    }

    if root.keyboard-target == "dialog" && root.dialog-mode == "text": Keyboard {

        secret: root.dialog-secret;
        title: root.dialog-title;
        value <=> root.dialog-value;
        erase => { root.erase-key(); }
        accepted => { root.close-keyboard(); }
        dismissed => { root.close-keyboard(); }
    }

    if root.keyboard-target == "move-name": Keyboard {

        title: I18n.text("filename");
        value <=> root.move-name;
        edited(_) => { root.picker-edited(); }
        erase => { root.keyboard-erase("move-name"); }
        accepted => { root.close-keyboard(); }
        dismissed => { root.close-keyboard(); }
    }

    if root.keyboard-target == "folder-name": Keyboard {

        title: I18n.text("folder_name");
        value <=> root.folder-name;
        edited(_) => { root.picker-edited(); }
        erase => { root.keyboard-erase("folder-name"); }
        accepted => { root.close-keyboard(); }
        dismissed => { root.close-keyboard(); }
    }

    if root.starting: StartupScreen {
        width: root.width;
        height: root.height;

        klipper: root.klipper-starting;
    }

    if root.sleeping: Rectangle {
        background: black;
        TouchArea {}
    }
}
