import { Label, Palette } from "widgets.slint";

component DialArc inherits Path {
    in property <angle> start;
    in property <angle> end;
    in property <float> radius;
    viewbox-width: 320;
    viewbox-height: 246;

    MoveTo {
        x: 160 + root.radius * cos(root.start);
        y: 125 + root.radius * sin(root.start);
    }

    ArcTo {
        x: 160 + root.radius * cos(root.end);
        y: 125 + root.radius * sin(root.end);
        radius-x: root.radius;
        radius-y: root.radius;
        sweep: true;
        large-arc: root.end - root.start > 180deg;
    }
}

export component PercentGauge inherits Rectangle {
    in property <int> target;
    in property <string> readout;
    in property <bool> red-zone;

    private property <float> scale: root.width / 320px;
    private property <angle> start-angle: 150deg;
    private property <angle> red-zone-start: 348deg;
    private property <angle> end-angle: 390deg;
    private property <angle> normal-end: root.red-zone ? root.red-zone-start : root.end-angle;
    private property <color> red-zone-color: Palette.dark ? #f46a66 : #c13b38;
    private property <angle> needle-angle: root.dial-angle(root.target);
    private property <color> needle-color: root.red-zone && root.needle-angle > root.red-zone-start ? root.red-zone-color : Palette.accent;
    animate needle-angle { duration: 210ms; easing: ease-out; }

    function dial-angle(percent: float) -> angle {
        if !root.red-zone {
            return root.start-angle + (root.end-angle - root.start-angle) * clamp(percent / 100, 0, 1);
        }
        return root.start-angle
            + (root.red-zone-start - root.start-angle) * clamp(percent / 300, 0, 1)
            + (root.end-angle - root.red-zone-start) * clamp((percent - 300) / 200, 0, 1);
    }

    DialArc {
        width: root.width; height: root.height;
        start: root.start-angle; end: root.normal-end; radius: 109;
        stroke: Palette.ink.transparentize(88%);
        stroke-width: 5px * root.scale;
    }

    if root.red-zone: DialArc {
        width: root.width; height: root.height;
        start: root.red-zone-start; end: root.end-angle; radius: 109;
        stroke: root.red-zone-color.transparentize(45%);
        stroke-width: 5px * root.scale;
    }

    DialArc {
        width: root.width; height: root.height;
        start: root.start-angle; end: min(root.needle-angle, root.normal-end); radius: 109;
        stroke: Palette.accent;
        stroke-width: 4px * root.scale;
    }

    if root.red-zone && root.needle-angle > root.red-zone-start: DialArc {
        width: root.width; height: root.height;
        start: root.red-zone-start; end: root.needle-angle; radius: 109;
        stroke: root.red-zone-color;
        stroke-width: 4px * root.scale;
    }

    // Print speed uses 12.5% steps in the normal zone and 50% steps in the red zone.
    for index in (root.red-zone ? 29 : 21): Path {
        width: parent.width; height: parent.height;
        viewbox-width: 320; viewbox-height: 246;
        private property <float> tick: root.red-zone ? (index <= 24 ? index * 12.5 : 300 + (index - 24) * 50) : index * 5;
        private property <angle> angle: root.dial-angle(tick);
        private property <bool> major: mod(index, root.red-zone && index > 24 ? 2 : 4) == 0;
        private property <float> inner: major ? 92 : 97;
        stroke: root.red-zone && tick >= 300 ? root.red-zone-color : major ? Palette.muted : Palette.ink.transparentize(70%);
        stroke-width: (major ? 2px : 1px) * root.scale;

        MoveTo { x: 160 + inner * cos(angle); y: 125 + inner * sin(angle); }
        LineTo { x: 160 + 102 * cos(angle); y: 125 + 102 * sin(angle); }
    }

    for tick in (root.red-zone ? [0, 50, 100, 150, 200, 250, 300, 400, 500] : [0, 20, 40, 60, 80, 100]): Label {
        private property <angle> angle: root.dial-angle(tick);
        width: 42px * root.scale;
        height: 20px * root.scale;
        x: (160px + 77px * cos(angle)) * root.scale - self.width / 2;
        y: (125px + 77px * sin(angle)) * root.scale - self.height / 2;
        text: "" + tick;
        font-size: 13px * root.scale;
        font-weight: 600;
        horizontal-alignment: center;
        color: root.red-zone && tick >= 300 ? root.red-zone-color : Palette.muted;
    }

    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 320; viewbox-height: 246;
        fill: root.needle-color;
        private property <angle> side: root.needle-angle + 90deg;

        MoveTo {
            x: 160 + 67 * cos(root.needle-angle);
            y: 125 + 67 * sin(root.needle-angle);
        }
        LineTo {
            x: 160 - 7 * cos(root.needle-angle) + 2.5 * cos(side);
            y: 125 - 7 * sin(root.needle-angle) + 2.5 * sin(side);
        }
        LineTo {
            x: 160 - 7 * cos(root.needle-angle) - 2.5 * cos(side);
            y: 125 - 7 * sin(root.needle-angle) - 2.5 * sin(side);
        }
        Close {}
    }

    Rectangle {
        width: 10px * root.scale;
        height: self.width;
        x: root.width / 2 - self.width / 2;
        y: 125px * root.scale - self.height / 2;
        border-radius: self.width / 2;
        background: root.needle-color;
    }

    Label {
        x: 100px * root.scale;
        y: 149px * root.scale;
        width: 120px * root.scale;
        height: 36px * root.scale;
        text: root.readout;
        horizontal-alignment: center;
        font-size: min(31px, 186px / max(1, root.readout.character-count)) * root.scale;
        font-weight: 700;
    }
}

component GaugeStepButton inherits Rectangle {
    in property <string> caption;
    in property <bool> enabled;
    in property <bool> accent;
    in property <bool> repeat-on-hold;
    callback clicked;

    private property <bool> repeated;
    private property <bool> holding: root.repeat-on-hold && root.enabled && hit.pressed
        && hit.mouse-x >= 0px && hit.mouse-x < self.width
        && hit.mouse-y >= 0px && hit.mouse-y < self.height;

    height: 44px;
    border-radius: 7px;
    border-width: 1px;
    border-color: (root.accent ? Palette.accent : Palette.ink).transparentize(82%);
    background: (!root.enabled ? Palette.surface :
        hit.pressed ? (root.accent ? Palette.accent.transparentize(68%) : Palette.raised.brighter(12%)) :
        hit.has-hover ? (root.accent ? Palette.accent.transparentize(77%) : Palette.raised) :
        root.accent ? Palette.accent.transparentize(87%) : Palette.ink.transparentize(95%));
    accessible-role: button;
    accessible-label: root.caption;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Timer {
        interval: root.repeated ? 90ms : 360ms;
        running: root.holding;
        triggered => {
            if root.holding {
                root.repeated = true;
                root.clicked();
            }
        }
    }

    Label {
        text: root.caption;
        horizontal-alignment: center;
        font-weight: 600;
        font-size: 17px;
        color: !root.enabled ? Palette.muted : root.accent ? Palette.accent : Palette.ink;
    }

    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.repeated = false;
            }
        }
        clicked => { if !root.repeated { root.clicked(); } }
    }
}

export component GaugeSteps inherits VerticalLayout {
    in property <[int]> steps;
    in property <bool> enabled;
    in property <string> shortcut-label;
    in property <bool> shortcut-enabled: true;
    callback adjust(int);
    callback select-shortcut;
    alignment: center;
    spacing: 8px;

    for step in root.steps: GaugeStepButton {
        caption: step < 0 ? "−" + abs(step) : "+" + step;
        accent: step > 0;
        enabled: root.enabled;
        repeat-on-hold: true;
        clicked => { root.adjust(step); }
    }

    if root.shortcut-label != "": GaugeStepButton {
        caption: root.shortcut-label;
        accent: root.steps[0] > 0;
        enabled: root.enabled && root.shortcut-enabled;
        clicked => { root.select-shortcut(); }
    }
}
