import { I18n } from "i18n.slint";
import { Icons } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { BusyCircle, Label, Mdi, Palette, Row, Tile } from "widgets.slint";

export struct MeshCell {
    fill: color,
}

export struct MeshRow {
    cells: [MeshCell],
}

component MeshGrid inherits Rectangle {
    in property <[MeshRow]> rows;
    in property <int> columns;
    in property <int> row-count;
    private property <length> cell-size: root.columns > 0 && root.row-count > 0
        ? max(0px, min((root.width + 1px) / root.columns, (root.height + 1px) / root.row-count) - 1px)
        : 0px;
    clip: true;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: (root.cell-size + 1px) * root.columns - 1px;
        height: (root.cell-size + 1px) * root.row-count - 1px;
        VerticalLayout {
            spacing: 1px;
            for mesh-row in root.rows: HorizontalLayout {
                height: root.cell-size;
                spacing: 1px;
                for cell in mesh-row.cells: Rectangle {
                    horizontal-stretch: 1;
                    background: cell.fill;
                }
            }
        }
    }
}

component MeshGraphCard inherits Rectangle {
    in property <[MeshRow]> mesh;
    callback action(string, string);
    min-height: 220px;
    background: Palette.surface;
    border-radius: 10px;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            Tile {
                icon: Icons.home-variant;
                accessible-role: button;
                accessible-label: I18n.text("home_axes");
                accessible-action-default => { root.action("home", ""); }
                clicked => { root.action("home", ""); }
            }
            Tile {
                label: I18n.text("clear_mesh");
                clicked => { root.action("mesh-clear", ""); }
            }
            Tile {
                label: I18n.text("calibrate");
                clicked => { root.action("mesh-calibrate", ""); }
            }
        }

        if root.mesh.length > 0: MeshGrid {
            vertical-stretch: 1;
            rows: root.mesh;
            columns: root.mesh[0].cells.length;
            row-count: root.mesh.length;
        }
        if root.mesh.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 8px;
            Mdi {
                text: Icons.grid;
                font-size: 56px;
                color: Palette.muted;
            }
            Label {
                text: I18n.text("no_loaded_mesh");
                color: Palette.muted;
                horizontal-alignment: center;
            }
        }
    }
}

component MeshProfilesCard inherits Rectangle {
    in property <[Row]> entries;
    callback action(string, string);
    min-height: 220px;
    background: Palette.surface;
    border-radius: 10px;

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 4px;
        spacing: 4px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            Label {
                text: I18n.text("available_meshes");
                font-size: 16px;
                font-weight: 600;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                if root.entries.length == 0: Rectangle {
                    height: 48px;
                    vertical-stretch: 0;
                    background: Palette.info.transparentize(88%);
                    border-radius: 6px;
                    Label {
                        x: 12px;
                        text: I18n.text("no_bed_mesh_profiles");
                        color: Palette.muted;
                    }
                }
                for entry in root.entries: Rectangle {
                    height: 56px;
                    vertical-stretch: 0;
                    background: entry.active ? Palette.accent.transparentize(84%) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            HorizontalLayout {
                                spacing: 8px;
                                Label {
                                    text: entry.title;
                                    horizontal-stretch: 1;
                                    font-weight: 700;
                                }
                                Label {
                                    text: entry.detail;
                                    horizontal-alignment: right;
                                    color: Palette.muted;
                                }
                            }
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => { root.action(entry.action, entry.argument); }
                            }
                        }
                        if !entry.active: Tile {
                            width: 40px;
                            height: 36px;
                            fill: transparent;
                            icon: Icons.progress-upload;
                            clicked => { root.action("mesh-calibrate", ""); }
                        }
                        if entry.alternate != "": Tile {
                            width: 40px;
                            height: 36px;
                            fill: transparent;
                            icon: Icons.delete;
                            ink: Palette.error;
                            clicked => { root.action(entry.alternate, entry.argument); }
                        }
                    }
                    Rectangle {
                        y: parent.height - self.height;
                        height: 1px;
                        background: Palette.divider;
                    }
                }
            }
        }
    }
}

component HeaterSelect inherits Tile {
    in property <string> heater;
    in property <bool> expanded;
    callback open(length, length, length);

    height: 40px;
    fill: Palette.raised;
    accessible-role: combobox;
    accessible-label: I18n.text("heater");
    accessible-value: root.heater;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-expand => { if root.enabled { root.clicked(); } }
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: field-focus;
    clicked => {
        root.open(root.absolute-position.x, root.absolute-position.y, root.width);
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Label {
            text: root.heater;
            color: root.enabled ? Palette.ink : Palette.muted;
            horizontal-stretch: 1;
        }
        Mdi {
            text: root.expanded ? Icons.chevron-up : Icons.chevron-down;
            width: 19px;
            font-size: 18px;
            color: Palette.muted;
        }
    }

    field-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component WebcamPanel inherits Rectangle {
    in property <image> frame;
    in property <string> status;
    in property <int> fps: -1;
    in property <bool> awake;
    callback frame-tick(float, float);

    private property <bool> loading: root.status == "loading";
    private property <bool> live: root.status == "live";
    private property <bool> has-frame: root.frame.width > 0;

    Timer {
        interval: 16ms;
        running: root.awake;
        triggered => { root.frame-tick(preview.width / 1px, preview.height / 1px); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 10px;
        spacing: 8px;

        preview := Rectangle {
            horizontal-stretch: 1;
            background: #08090b;
            border-radius: 12px;
            clip: true;

            if root.has-frame: Image {
                width: parent.width;
                height: parent.height;
                source: root.frame;
                image-fit: contain;
            }

            if root.has-frame && root.live && root.fps >= 0: Rectangle {
                private property <length> image-width: min(parent.width, parent.height * root.frame.width / root.frame.height);
                private property <length> image-height: min(parent.height, parent.width * root.frame.height / root.frame.width);
                x: (parent.width + self.image-width) / 2 - self.width - 10px;
                y: (parent.height + self.image-height) / 2 - self.height - 10px;
                width: fps-label.preferred-width + 16px;
                height: 25px;
                border-radius: 5px;
                background: #101114c9;

                fps-label := Label {
                    text: "\{root.fps} " + I18n.text("webcam_fps_unit");
                    color: #ffffff;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            if !root.live && root.status != "snapshot": Rectangle {
                y: root.has-frame ? parent.height - self.height - 12px : (parent.height - self.height) / 2;
                width: min(parent.width - 24px, status-row.preferred-width);
                height: 40px;
                border-radius: 20px;
                background: #1c2026ee;
                status-row := HorizontalLayout {
                    alignment: center;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 9px;
                    if root.loading: BusyCircle { width: 18px; height: 18px; cross-axis-self-alignment: center; }
                    Label {
                        text: I18n.text(root.loading ? "loading_webcams"
                            : root.status == "empty" ? "no_webcams" : "webcam_preview_unavailable");
                        color: #ffffff;
                        font-size: 14px;
                    }
                }
            }
        }
    }
}

export component ToolsPanel inherits Rectangle {
    in property <string> view;
    in property <string> title;
    in property <[Row]> entries;
    in property <[MeshRow]> mesh;
    in property <string> pid-target;
    in property <string> pid-current;
    in property <[string]> heater-options;
    in property <int> heater-index;
    in property <bool> pid-ready;
    in property <bool> pid-running;
    in property <bool> pid-complete;
    in property <bool> webcam-loading;
    in property <bool> awake;
    callback webcam-frame-tick(float, float);
    in property <string> webcam-status;
    in property <int> webcam-fps: -1;
    private property <bool> camera-menu-open;
    private property <length> camera-menu-width: 220px;
    private property <bool> heater-menu-open;
    private property <int> heater-highlight;
    private property <length> heater-menu-x;
    private property <length> heater-menu-y;
    private property <length> heater-menu-width;
    private property <length> heater-menu-height: min(5, root.heater-options.length) * 40px + 8px;
    changed view => {
        root.camera-menu-open = false;
        root.heater-menu-open = false;
    }
    changed heater-options => { root.heater-menu-open = false; }
    changed pid-running => { if root.pid-running { root.heater-menu-open = false; } }
    changed width => { root.heater-menu-open = false; }
    changed height => { root.heater-menu-open = false; }
    in property <image> webcam-image;
    in property <[string]> webcam-options;
    in property <int> webcam-index;
    callback action(string, string);

    function open-heater-menu(x: length, y: length, width: length) {
        root.heater-menu-x = x - root.absolute-position.x;
        root.heater-menu-width = width;
        let above = y - root.absolute-position.y;
        let below = above + 44px;
        root.heater-menu-y = below + root.heater-menu-height <= root.height
            ? below : max(0px, above - root.heater-menu-height - 4px);
        root.heater-highlight = max(0, root.heater-index);
        root.heater-menu-open = true;
        heater-menu-focus.focus();
    }

    function choose-heater(index: int) {
        root.heater-menu-open = false;
        if index != root.heater-index && index >= 0 && index < root.heater-options.length {
            root.action("pid-heater", "\{index}");
        }
    }

    clip: true;

    VerticalLayout {
        spacing: 0px;

        if root.view != "": HorizontalLayout {
            height: 48px;
            padding-right: 8px;
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    alignment: start;
                    spacing: 16px;
                    Mdi { text: Icons.arrow-left; color: Palette.ink; }
                    Label { text: root.title; font-size: 19px; font-weight: 700; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.action("tools-home", ""); }
                }
            }
            if root.view == "camera": Tile {
                width: root.camera-menu-width;
                height: 36px;
                cross-axis-self-alignment: center;
                fill: Palette.surface;
                accessible-role: button;
                accessible-label: I18n.text("select_webcam");
                accessible-expandable: true;
                accessible-expanded: root.camera-menu-open;
                accessible-action-default => { self.clicked(); }
                clicked => {
                    root.camera-menu-open = !root.camera-menu-open;
                    if root.camera-menu-open { camera-menu-focus.focus(); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 8px;
                    Mdi { text: Icons.webcam; width: 20px; font-size: 19px; color: Palette.muted; }
                    Label {
                        horizontal-stretch: 1;
                        text: root.webcam-index >= 0 && root.webcam-index < root.webcam-options.length
                            ? root.webcam-options[root.webcam-index] : I18n.text("select_webcam");
                    }
                    Mdi { text: Icons.chevron-down; width: 19px; font-size: 18px; color: Palette.muted; }
                }
            }
        }

        if root.view == "": ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 0px;
                for entry[index] in root.entries: Rectangle {
                    height: 56px;
                    vertical-stretch: 0;
                    background: home-touch.has-hover ? Palette.raised : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        if entry.icon != "": Mdi {
                            text: entry.icon;
                            width: 24px;
                            font-size: 20px;
                            color: Palette.muted;
                        }
                        Label {
                            text: entry.title;
                            horizontal-stretch: 1;
                            font-weight: 600;
                        }
                    }
                    home-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.action(entry.action, entry.argument); }
                    }
                    if index < root.entries.length - 1: Rectangle {
                        x: 0px;
                        y: parent.height - self.height;
                        width: parent.width;
                        height: 1px;
                        background: Palette.divider;
                    }
                }
            }
        }

        if root.view == "mesh": ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            if root.width >= 640px: HorizontalLayout {
                spacing: 12px;
                MeshGraphCard {
                    horizontal-stretch: 1.15;
                    vertical-stretch: 1;
                    mesh: root.mesh;
                    action(name, argument) => { root.action(name, argument); }
                }
                MeshProfilesCard {
                    horizontal-stretch: 0.85;
                    vertical-stretch: 1;
                    entries: root.entries;
                    action(name, argument) => { root.action(name, argument); }
                }
            }
            if root.width < 640px: VerticalLayout {
                spacing: 12px;
                MeshGraphCard {
                    vertical-stretch: 1;
                    mesh: root.mesh;
                    action(name, argument) => { root.action(name, argument); }
                }
                MeshProfilesCard {
                    vertical-stretch: 1;
                    entries: root.entries;
                    action(name, argument) => { root.action(name, argument); }
                }
            }
        }

        if root.view == "pid": ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            mouse-drag-pan-enabled: true;
            VerticalLayout {
              Rectangle {
                height: pid-card.preferred-height;
                background: Palette.surface;
                border-radius: 10px;
                pid-card := VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 20px;
                        VerticalLayout {
                            width: min(320px, root.width * 0.42);
                            spacing: 8px;
                            alignment: start;
                            Rectangle {
                                height: 62px;
                                background: Palette.raised;
                                border-radius: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Label { text: I18n.text("target_temperature"); color: Palette.muted; horizontal-alignment: center; }
                                    Label {
                                        text: (root.pid-target == "" ? "0" : root.pid-target) + "°C";
                                        font-size: 24px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                height: 62px;
                                background: Palette.raised;
                                border-radius: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Label { text: I18n.text("current_temperature"); color: Palette.muted; horizontal-alignment: center; }
                                    Label { text: root.pid-current + "°C"; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
                                }
                            }
                            Label { text: I18n.text("heater"); color: Palette.muted; }
                            HeaterSelect {
                                heater: root.heater-index >= 0 && root.heater-index < root.heater-options.length
                                    ? root.heater-options[root.heater-index] : "—";
                                expanded: root.heater-menu-open;
                                enabled: root.heater-options.length > 0 && !root.pid-running;
                                open(x, y, width) => { root.open-heater-menu(x, y, width); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 5px;
                                for keys in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]: HorizontalLayout {
                                    spacing: 5px;
                                    for key in keys: Tile {
                                        label: key;
                                        horizontal-stretch: 1;
                                        min-height: 56px;
                                        enabled: !root.pid-running;
                                        clicked => { root.action("pid-digit", key); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    Tile {
                                        icon: Icons.delete-outline;
                                        horizontal-stretch: 1;
                                        min-height: 56px;
                                        enabled: !root.pid-running;
                                        clicked => { root.action("pid-clear", ""); }
                                    }
                                    Tile {
                                        label: "0";
                                        horizontal-stretch: 1;
                                        min-height: 56px;
                                        enabled: !root.pid-running;
                                        clicked => { root.action("pid-digit", "0"); }
                                    }
                                    Tile {
                                        icon: Icons.backspace-outline;
                                        horizontal-stretch: 1;
                                        min-height: 56px;
                                        enabled: !root.pid-running;
                                        clicked => { root.action("pid-backspace", ""); }
                                    }
                                }
                            }
                            if root.pid-running: Label {
                                text: I18n.text("pid_calibration_running");
                                color: Palette.info;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        if root.pid-complete: Tile {
                            width: min(210px, (root.width - 32px) / 2);
                            label: I18n.text("save_configuration");
                            fill: Palette.secondary;
                            clicked => { root.action("save-printer", ""); }
                        }
                        Tile {
                            width: min(210px, root.pid-complete ? (root.width - 32px) / 2 : root.width - 24px);
                            label: I18n.text("run_pid_calibration");
                            fill: Palette.accent;
                            enabled: root.pid-ready && root.pid-target != "" && !root.pid-running;
                            clicked => { root.action("pid-run", ""); }
                        }
                    }
                }
              }
            }
        }

        if root.view == "camera": WebcamPanel {
            vertical-stretch: 1;
            awake: root.awake;
            frame-tick(width, height) => { root.webcam-frame-tick(width, height); }
            frame: root.webcam-image;
            status: root.webcam-status;
            fps: root.webcam-fps;
        }
    }
    heater-menu-focus := FocusScope {
        enabled: root.heater-menu-open;
        focus-on-click: false;
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.heater-menu-open = false; return accept; }
            if (event.text == Key.UpArrow) { root.heater-highlight = max(0, root.heater-highlight - 1); return accept; }
            if (event.text == Key.DownArrow) { root.heater-highlight = min(root.heater-options.length - 1, root.heater-highlight + 1); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.choose-heater(root.heater-highlight); return accept; }
            return reject;
        }

        if root.heater-menu-open: Rectangle {
            width: parent.width;
            height: parent.height;
            TouchArea { clicked => { root.heater-menu-open = false; } }

            Rectangle {
                x: root.heater-menu-x;
                y: root.heater-menu-y;
                width: root.heater-menu-width;
                height: root.heater-menu-height;
                background: Palette.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.divider;
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-y: -max(0, root.heater-highlight - 4) * 40px;
                    VerticalLayout {
                        alignment: start;
                        padding: 4px;
                        for heater[index] in root.heater-options: Tile {
                            height: 40px;
                            fill: index == root.heater-highlight ? Palette.accent.transparentize(86%) : transparent;
                            accessible-role: button;
                            accessible-label: heater;
                            accessible-action-default => { self.clicked(); }
                            clicked => { root.choose-heater(index); }
                            Label { x: 8px; width: parent.width - 16px; text: heater; }
                        }
                    }
                }
            }
        }
    }

    camera-menu-focus := FocusScope {
        enabled: root.camera-menu-open;
        focus-on-click: false;
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.camera-menu-open = false;
                return accept;
            }
            return reject;
        }

        if root.camera-menu-open: Rectangle {
            width: parent.width;
            height: parent.height;
            TouchArea { clicked => { root.camera-menu-open = false; } }

            Rectangle {
                x: parent.width - self.width - 8px;
                y: 45px;
                width: root.camera-menu-width;
                height: min(parent.height - self.y - 6px, 50px + root.webcam-options.length * 40px);
                background: Palette.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.divider;
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start;
                        padding: 5px;
                        for name[index] in root.webcam-options: Tile {
                            height: 40px;
                            fill: root.webcam-index == index ? Palette.accent.transparentize(86%) : transparent;
                            accessible-role: button;
                            accessible-label: name;
                            accessible-action-default => { self.clicked(); }
                            clicked => {
                                root.camera-menu-open = false;
                                if index != root.webcam-index {
                                    root.action("webcam-select", "\{index}");
                                }
                            }
                            Label { x: 10px; width: parent.width - 20px; text: name; }
                        }
                        Tile {
                            height: 40px;
                            fill: transparent;
                            enabled: !root.webcam-loading;
                            accessible-role: button;
                            accessible-label: I18n.text("reload_webcams");
                            accessible-action-default => { if self.enabled { self.clicked(); } }
                            clicked => { root.action("webcam-refresh-list", ""); }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                if root.webcam-loading: BusyCircle {
                                    width: 17px; height: 17px; cross-axis-self-alignment: center;
                                }
                                if !root.webcam-loading: Mdi { text: Icons.reload; width: 17px; font-size: 17px; }
                                Label { text: I18n.text("reload_webcams"); horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }

}
