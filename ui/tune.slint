import { ScrollView, LineEdit } from "std-widgets.slint";
import { Icons } from "icons.slint";
import { Palette, Row, Label, Mdi, Tile } from "widgets.slint";

export struct FilamentSensor {
    key: string,
    name: string,
    enabled: bool,
    detected: bool,
}

component FilamentSensorButton inherits Tile {
    in property <FilamentSensor> sensor;
    in property <bool> german;
    height: 56px;
    border-radius: 0px;
    fill: !root.sensor.enabled ? Palette.ink.transparentize(82%) :
        root.sensor.detected ? Palette.accent : Palette.warning.transparentize(88%);
    ink: !root.sensor.enabled ? Palette.muted : root.sensor.detected ? #ffffff : Palette.warning;
    accessible-role: button;
    accessible-label: root.sensor.name + (root.sensor.enabled
        ? (root.german ? ", aktiviert" : ", enabled")
        : (root.german ? ", deaktiviert" : ", disabled"));
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Label {
        x: 6px; width: parent.width - 12px;
        text: root.sensor.name;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        wrap: word-wrap;
        color: root.enabled ? root.ink : root.ink.transparentize(40%);
    }
}

component Move inherits Tile {
    in property <bool> compact;
    width: compact ? 55px : 72px;
    height: compact ? 55px : 72px;
    icon-size: 24px;
    stacked: true;
    fill: Palette.surface;
}

export component MotionPanel inherits Rectangle {
    in property <bool> german;
    in property <bool> enabled;
    in property <bool> sensors-enabled;
    in property <bool> x-homed;
    in property <bool> y-homed;
    in property <bool> z-homed;
    in property <bool> has-tilt;
    in property <bool> has-qgl;
    in property <float> step;
    in property <[Row]> controls;
    in property <[FilamentSensor]> sensors;
    callback action(string, string);
    private property <bool> compact: root.width < 650px || root.height < 330px;

    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-top: 8px;
        padding-right: 10px;
        padding-bottom: 8px;
        spacing: 14px;

        Rectangle {
            width: root.compact ? 82px : 112px;
            background: Palette.raised; border-radius: 6px;
            ScrollView {
                VerticalLayout {
                    for control in root.controls: VerticalLayout {
                        Rectangle {
                            height: 55px;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 5px;
                                Label { text: control.title; font-size: 12px; color: Palette.muted; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Mdi { text: control.icon; color: control.tone; font-size: 17px; width: 17px; }
                                    Label { text: control.detail; font-weight: 600; horizontal-stretch: 1; }
                                }
                            }
                            TouchArea {
                                enabled: control.action != "";
                                mouse-cursor: pointer;
                                clicked => { root.action(control.action, control.argument); }
                            }
                        }
                        Rectangle { height: 1px; background: Palette.divider; }
                    }
                }
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: root.compact ? 10px : 20px;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                HorizontalLayout {
                    alignment: center;
                    GridLayout {
                        spacing: root.compact ? 5px : 10px;
                        Move { row: 0; col: 1; compact: root.compact; icon: Icons.chevron-up; enabled: root.enabled && root.y-homed; clicked => { root.action("jog-plus", "Y"); } }
                        Move { row: 1; col: 0; compact: root.compact; icon: Icons.chevron-left; enabled: root.enabled && root.x-homed; clicked => { root.action("jog-minus", "X"); } }
                        Move { row: 1; col: 1; compact: root.compact; icon: Icons.home; label: "XY"; enabled: root.enabled; clicked => { root.action("home", "X Y"); } }
                        Move { row: 1; col: 2; compact: root.compact; icon: Icons.chevron-right; enabled: root.enabled && root.x-homed; clicked => { root.action("jog-plus", "X"); } }
                        Move { row: 2; col: 1; compact: root.compact; icon: Icons.chevron-down; enabled: root.enabled && root.y-homed; clicked => { root.action("jog-minus", "Y"); } }
                    }
                }

                Rectangle {
                    border-radius: 5px;
                    background: Palette.surface;
                    clip: true;
                    HorizontalLayout {
                        spacing: 1px;
                        for item in ["0.1", "1", "10", "25"]: Tile {
                            min-width: root.compact ? 36px : 56px;
                            active: root.step == item.to-float();
                            label: item;
                            fill: self.active ? Palette.accent : Palette.surface;
                            enabled: root.enabled;
                            border-radius: 0px;
                            clicked => { root.action("set-step", item); }
                        }
                        Tile {
                            icon: Icons.engine-off; border-radius: 0px; fill: Palette.surface;
                            enabled: root.enabled; clicked => { root.action("disable-motors", ""); }
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: root.compact ? 5px : 10px;
                Move { compact: root.compact; icon: Icons.chevron-up; enabled: root.enabled && root.z-homed; clicked => { root.action("jog-plus", "Z"); } }
                Move { compact: root.compact; icon: Icons.home; label: "Z"; enabled: root.enabled; clicked => { root.action("home", "Z"); } }
                Move { compact: root.compact; icon: Icons.chevron-down; enabled: root.enabled && root.z-homed; clicked => { root.action("jog-minus", "Z"); } }
                HorizontalLayout {
                    min-height: 36px;
                    spacing: 5px;
                    if root.has-tilt: Tile {
                        label: "Z Tilt"; enabled: root.enabled && root.x-homed && root.y-homed;
                        clicked => { root.action("z-tilt", ""); }
                    }
                    if root.has-qgl: Tile {
                        label: "QGL"; enabled: root.enabled && root.x-homed && root.y-homed;
                        clicked => { root.action("qgl", ""); }
                    }
                }
            }
        }

        Rectangle {
            width: root.compact ? 82px : 112px;

            Rectangle {
                y: 0px;
                height: min(parent.height, (root.sensors.length + 2) * 57px);
                background: Palette.surface;
                border-radius: 4px;
                clip: true;

                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        Tile {
                            label: root.german ? "Laden" : "Load";
                            height: 56px; border-radius: 0px; fill: transparent;
                            enabled: root.enabled;
                            clicked => { root.action("load-filament", ""); }
                        }
                        Rectangle { height: 1px; background: Palette.divider; }
                        Tile {
                            label: root.german ? "Entladen" : "Unload";
                            height: 56px; border-radius: 0px; fill: transparent;
                            enabled: root.enabled;
                            clicked => { root.action("unload-filament", ""); }
                        }
                        Rectangle { height: 1px; background: Palette.divider; }
                        for sensor in root.sensors: VerticalLayout {
                            FilamentSensorButton {
                                sensor: sensor;
                                german: root.german;
                                enabled: root.sensors-enabled;
                                clicked => { root.action("toggle-filament-sensor", sensor.key); }
                            }
                            Rectangle { height: 1px; background: Palette.divider; }
                        }
                    }
                }
            }
        }
    }
}

component Adjustment inherits Rectangle {
    in property <string> label;
    in property <string> current;
    in property <[string]> steps;
    in property <bool> enabled;
    callback apply(string);
    border-radius: 6px;
    background: Palette.surface;
    min-height: 96px;

    changed current => { field.text = root.current; }

    VerticalLayout {
        padding: 10px;
        spacing: 9px;
        Label { text: root.label; font-weight: 600; font-size: 17px; }
        HorizontalLayout {
            spacing: 5px;
            for step in [root.steps[0], root.steps[1], root.steps[2]]: Tile {
                label: (step.starts-with("-") ? "" : "+") + step;
                enabled: root.enabled;
                clicked => { field.text = round((field.text.to-float() + step.to-float()) * 1000) / 1000; }
            }
            field := LineEdit { text: root.current; horizontal-stretch: 1; enabled: root.enabled; }
            for step in [root.steps[3], root.steps[4], root.steps[5]]: Tile {
                label: "+" + step;
                enabled: root.enabled;
                clicked => { field.text = round((field.text.to-float() + step.to-float()) * 1000) / 1000; }
            }
            Tile {
                icon: Icons.check; active: true; enabled: root.enabled;
                clicked => { root.apply(field.text); }
            }
        }
    }
}

export component PrintOptions inherits ScrollView {
    in property <bool> german;
    in property <string> flow;
    in property <string> advance;
    in property <string> smooth;
    callback action(string, string);

    VerticalLayout {
        padding-top: 8px;
        padding-right: 10px;
        spacing: 8px;
        Adjustment {
            label: root.german ? "Fluss" : "Flow";
            current: root.flow;
            enabled: root.enabled;
            steps: ["-10", "-5", "-1", "1", "5", "10"];
            apply(value) => { root.action("set-flow", value); }
        }
        Adjustment {
            label: root.german ? "Druckvorschub (PA)" : "Pressure Advance";
            current: root.advance;
            enabled: root.enabled;
            steps: ["-0.01", "-0.005", "-0.001", "0.001", "0.005", "0.01"];
            apply(value) => { root.action("set-advance", value); }
        }
        Adjustment {
            label: root.german ? "PA-Glättungszeit" : "PA Smooth Time";
            current: root.smooth;
            enabled: root.enabled;
            steps: ["-0.01", "-0.005", "-0.001", "0.001", "0.005", "0.01"];
            apply(value) => { root.action("set-smooth", value); }
        }
    }
}
